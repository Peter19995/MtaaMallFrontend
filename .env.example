# API Configuration
VITE_API_URL=https://api.julian-interiors.com/api/v1
VITE_API_BASE_URL=https://api.julian-interiors.com/api/v1
VITE_WEBSOCKET_URL=ws://localhost:8000/ws

# Feature Flags
VITE_ENABLE_AI_AGENTS=true
VITE_ENABLE_LOYALTY_PROGRAM=true
VITE_ENABLE_DESIGN_TOOLS=true
VITE_ENABLE_MULTI_BRANCH=true

# Payment Gateways
VITE_STRIPE_PUBLIC_KEY=pk_test_...
VITE_PAYPAL_CLIENT_ID=...

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=...

# Analytics
VITE_GOOGLE_ANALYTICS_ID=...

# App Configuration
VITE_APP_NAME="Julian Interiors"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
